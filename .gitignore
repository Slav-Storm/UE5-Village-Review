# Deny everything except small visual-review documents and images.
*
!/.gitignore
!/.gitattributes
!/README.md
!/REVIEW.md
!/AGENTS.md
!/latest/
!/latest/*.png
!/latest/*.jpg
!/latest/*.jpeg
!/latest/*.webp
!/latest/*.json
!/latest/*.md
!/archive/
!/archive/**/
!/archive/**/*.png
!/archive/**/*.jpg
!/archive/**/*.jpeg
!/archive/**/*.webp
!/archive/**/*.json
!/archive/**/*.md

# User-requested high-resolution, editable 2D planning review.
!/latest/map/
!/latest/map/*.png
!/latest/map/*.svg
!/latest/map/*.md
!/latest/map/map_data.json
!/latest/map/map_views.json
!/latest/map/massacre_annotations.json
!/latest/map/provenance.json
!/latest/map/render_map.py

# Separate user-authorized T0 ordinary-activity review layer.
!/latest/map/t0_activity.json
!/latest/map/t0_manifest.json
!/latest/map/render_t0.py

# Separate user-authorized T1 opening simulation, ending at +90 seconds.
!/latest/map/t1_simulation.json
!/latest/map/t1_manifest.json
!/latest/map/t1_awareness.csv
!/latest/map/render_t1.py

# Separate user-authorized Step 2B completion and locked rules.
!/latest/map/bone_completion.json
!/latest/map/massacre_behaviour_rules.json
!/latest/map/t1b_manifest.json
!/latest/map/t1b_awareness.csv
!/latest/map/render_bone_completion.py

# Separate user-authorized Step 3 civilian-only reaction planning.
!/latest/map/t2_civilian_reactions.json
!/latest/map/t2_manifest.json
!/latest/map/t2_reactions.csv
!/latest/map/render_t2.py

# Separate user-authorized Step 4 short supernatural action planning.
!/latest/map/t3_second_action.json
!/latest/map/t3_manifest.json
!/latest/map/t3_reception.csv
!/latest/map/render_t3.py
